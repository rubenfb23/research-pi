{
  "name": "research-pi",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "repi": "repi",
    "research-pi": "repi"
  },
  "scripts": {
    "build": "tsc",
    "start": "node repi",
    "install:cli": "node scripts/install-cli.mjs",
    "uninstall:cli": "npm uninstall --global research-pi",
    "package:native": "node scripts/package-native.mjs",
    "test": "tsx --test tests/*.test.ts && node --test scripts/official-bench/relay.test.mjs scripts/official-replay-parser.test.mjs",
    "check": "npm run build && npm test",
    "demo": "node repi demo"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "description": "Research harness built on Pi: reproducible ML experiments, scientific protocols and evidence-linked papers",
  "homepage": "https://github.com/rubenfb23/research-pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenfb23/research-pi.git"
  },
  "bugs": {
    "url": "https://github.com/rubenfb23/research-pi/issues"
  },
  "author": "Ruben Fernandez Boullon"
}
