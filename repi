#!/usr/bin/env node
// Dependency-free entry point: a fresh checkout needs only Node and npm.
import { createHash } from 'node:crypto';
import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync, realpathSync } from 'node:fs';
import { homedir } from 'node:os';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { spawnSync } from 'node:child_process';

let root = dirname(fileURLToPath(import.meta.url));
function fail(message) { console.error(message); process.exit(1); }
const [major, minor] = process.versions.node.split('.').map(Number);
if (major < 22 || (major === 22 && minor < 19)) fail('ResearchPi requires Node >=22.19. Install it and run ./repi again.');
if (existsSync(join(root, 'package-runtime.json'))) {
  const base = realpathSync(root);
  const version = JSON.parse(readFileSync(join(root,'package.json'),'utf8')).version;
  const home = homedir();
  const data = process.env.RESEARCH_PI_DATA_DIR || (process.platform === 'win32'
    ? join(process.env.LOCALAPPDATA || join(home,'AppData','Local'),'ResearchPi')
    : process.platform === 'darwin' ? join(home,'Library','Application Support','ResearchPi')
    : join(process.env.XDG_DATA_HOME?.startsWith('/') ? process.env.XDG_DATA_HOME : join(home,'.local','share'),'research-pi'));
  const key = createHash('sha256').update(base + '\n' + version).digest('hex').slice(0,24);
  const pointer = join(data,'runtime-updates',key,'active.json');
  process.env.RESEARCH_PI_BASE_ROOT=base;
  process.env.RESEARCH_PI_UPDATE_POINTER=pointer;
  if (existsSync(pointer)) {
    const active=JSON.parse(readFileSync(pointer,'utf8'));
    if (active.base !== base || active.version !== version || !existsSync(join(active.root,'dist','cli.js'))) fail('The updated runtime is unavailable. Remove ' + pointer + ' to use the original installation.');
    root=active.root;
  }
}
// Run before SDK imports, so a broken dependency cannot prevent an update.
if (process.argv[2] === 'update') {
  const result=spawnSync(process.execPath,[join(root,'scripts','update-pi.mjs'),root,...process.argv.slice(3)],{stdio:'inherit',env:process.env});
  if (result.error) fail(result.error.message);
  process.exit(result.signal === 'SIGINT' ? 130 : result.status ?? 1);
}
if (existsSync(join(root, 'package-runtime.json'))) {
  // Native installers already include Node, dependencies and compiled code.
  // Never install, compile or write inside the system application directory.
  process.argv = [process.execPath, join(root, 'dist', 'cli.js'), ...process.argv.slice(2)];
  await import(pathToFileURL(join(root,'dist','cli.js')).href);
} else {
const digest = paths => {
  const hash = createHash('sha256');
  for (const path of paths.sort()) { hash.update(path); hash.update(readFileSync(join(root, path))); }
  return hash.digest('hex');
};
function run(exe, args) {
  const result = spawnSync(exe, args, { cwd: root, stdio: 'inherit', shell: process.platform === 'win32' && exe.endsWith('.cmd') });
  if (result.error) fail(`Could not start ${exe}. Check that it is installed.`);
  if (result.signal) process.exit(result.signal === 'SIGINT' ? 130 : 1);
  if (result.status !== 0) process.exit(result.status ?? 1);
}
const cache = join(root, 'node_modules', '.research-pi-launcher.json');
let old = {};
try { old = JSON.parse(readFileSync(cache, 'utf8')); } catch {}
const dependencies = digest(['package.json', 'package-lock.json']);
if (old.dependencies !== dependencies || !existsSync(join(root, 'node_modules', 'typescript', 'bin', 'tsc'))
    || !existsSync(join(root, 'node_modules', '@earendil-works', 'pi-coding-agent', 'package.json'))) {
  console.error('Installing ResearchPi dependencies…');
  run(process.platform === 'win32' ? 'npm.cmd' : 'npm', ['ci']); old = { dependencies };
}
const sources = digest(['tsconfig.json', 'package-lock.json', ...readdirSync(join(root, 'src')).filter(n => n.endsWith('.ts')).map(n => 'src/' + n)]);
const built = () => existsSync(join(root, 'dist', 'cli.js'))
  ? digest(readdirSync(join(root, 'dist')).filter(n => n.endsWith('.js')).map(n => 'dist/' + n)) : null;
if (old.sources !== sources || old.compiled !== built()) {
  console.error('Preparing ResearchPi…'); run(process.execPath, ['node_modules/typescript/bin/tsc']);
}
mkdirSync(join(root, 'node_modules'), { recursive: true });
writeFileSync(cache, JSON.stringify({ dependencies, sources, compiled: built() }));
// Import in this process so Ctrl+C, terminal input and streamed output reach the CLI.
process.argv = [process.execPath, join(root, 'dist', 'cli.js'), ...process.argv.slice(2)];
await import('./dist/cli.js');
}
